{
  "openapi": "3.1.0",
  "info": {
    "title": "Chat REST API",
    "description": "REST endpoints for chat rooms and message history.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local chat backend"
    }
  ],
  "paths": {
    "/api/rooms": {
      "get": {
        "operationId": "listRooms",
        "summary": "List chat rooms",
        "tags": ["rooms"],
        "responses": {
          "200": {
            "description": "Available chat rooms",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ChatRoom" }
                }
              }
            }
          }
        }
      }
    },
    "/api/rooms/{roomId}/messages": {
      "get": {
        "operationId": "listRoomMessages",
        "summary": "List messages of a chat room",
        "tags": ["rooms"],
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Messages in the room",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ChatMessage" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRoom": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "memberCount": { "type": "integer", "format": "int32" }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": ["id", "roomId", "authorId", "authorName", "text", "sentAt"],
        "properties": {
          "id": { "type": "string" },
          "roomId": { "type": "string" },
          "authorId": { "type": "string" },
          "authorName": { "type": "string" },
          "text": { "type": "string" },
          "sentAt": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
