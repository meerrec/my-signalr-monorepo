<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SignalRChat.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SignalR.OpenApi 1.1.68 работает с Microsoft.OpenApi 1.x; версия 10.x тянет 2.x. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.14" />
    <PackageReference Include="SignalR.OpenApi" Version="1.1.68" />
    <PackageReference Include="SignalR.OpenApi.SwaggerUi" Version="1.1.68" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SignalRChat.Application/SignalRChat.Application.csproj" />
    <ProjectReference Include="../SignalRChat.Infrastructure/SignalRChat.Infrastructure.csproj" />
    <ProjectReference Include="../SignalRChat.Domain/SignalRChat.Domain.csproj" />
  </ItemGroup>

</Project>
