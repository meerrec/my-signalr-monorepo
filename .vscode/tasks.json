{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Установить зависимости",
      "description": "pnpm install для всего монорепозитория",
      "type": "shell",
      "command": "pnpm install",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "inAgents": true,
      "runOptions": {
        "runOn": "worktreeCreated"
      }
    },
    {
      "label": "Запустить dev-сервер",
      "description": "Vite dev-сервер приложения @chat/web",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "inAgents": true
    }
  ]
}
